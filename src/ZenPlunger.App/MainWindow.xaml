<Window x:Class="ZenPlunger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zen Plunger"
        Height="520"
        Width="900"
        MinHeight="420"
        MinWidth="720"
        Background="#111318">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Zen Plunger"
                       Foreground="#F4F7FA"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Pinball FX cabinet launcher shell"
                       Foreground="#AAB3C0"
                       FontSize="15"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="ProcessStateText"
                       Foreground="#7FC8A9"
                       FontSize="14"
                       Margin="0,10,0,0"
                       Text="Checking Pinball FX process state..." />
            <TextBlock Text="Use Ctrl+Alt+Space to toggle the fullscreen overlay for warm-launch testing."
                       Foreground="#D3B97A"
                       FontSize="14"
                       Margin="0,8,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#DDE5EE"
                           Text="Steam Folder" />
                <TextBox x:Name="SteamFolderPathTextBox"
                         Grid.Column="1"
                         MinWidth="340"
                         Padding="8,6"
                         Background="#101318"
                         BorderBrush="#303844"
                         Foreground="#F4F7FA" />
                <Button x:Name="SaveSteamFolderButton"
                        Grid.Column="2"
                        Width="150"
                        Height="34"
                        Margin="12,0,0,0"
                        Click="SaveSteamFolderButton_Click"
                        Content="Save Steam Path" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,20"
                BorderBrush="#303844"
                BorderThickness="1"
                Background="#181C22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Tables"
                           Foreground="#DDE5EE"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="16,14,16,10" />

                <ListBox x:Name="TableList"
                         Grid.Row="1"
                         Margin="12,0,12,12"
                         Background="#101318"
                         BorderBrush="#303844"
                         DisplayMemberPath="DisplayName"
                         Foreground="#F4F7FA" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Foreground="#AAB3C0"
                       TextWrapping="Wrap"
                       Text="Select a table to launch via Steam." />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="ShowOverlayButton"
                        Width="130"
                        Height="38"
                        Margin="0,0,12,0"
                        Click="ShowOverlayButton_Click"
                        Content="Show Overlay" />
                <Button x:Name="RefreshStatusButton"
                        Width="130"
                        Height="38"
                        Margin="0,0,12,0"
                        Click="RefreshStatusButton_Click"
                        Content="Refresh Status" />
                <Button x:Name="LaunchButton"
                        Width="150"
                        Height="38"
                        Click="LaunchButton_Click"
                        Content="Launch Table" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
