<Window x:Class="ZenPlunger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zen Plunger"
        Height="520"
        Width="900"
        MinHeight="420"
        MinWidth="720"
        Background="#111318">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Zen Plunger"
                       Foreground="#F4F7FA"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Pinball FX cabinet launcher shell"
                       Foreground="#AAB3C0"
                       FontSize="15"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,20"
                BorderBrush="#303844"
                BorderThickness="1"
                Background="#181C22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Tables"
                           Foreground="#DDE5EE"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="16,14,16,10" />

                <ListBox x:Name="TableList"
                         Grid.Row="1"
                         Margin="12,0,12,12"
                         Background="#101318"
                         BorderBrush="#303844"
                         DisplayMemberPath="DisplayName"
                         Foreground="#F4F7FA" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="True">
            <Button x:Name="LaunchButton"
                    DockPanel.Dock="Right"
                    Width="150"
                    Height="38"
                    Click="LaunchButton_Click"
                    Content="Launch Table" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#AAB3C0"
                       Text="Select a table to launch via Steam." />
        </DockPanel>
    </Grid>
</Window>
