<Window x:Class="ZenPlunger.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zen Plunger Overlay"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#E6111318">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Zen Plunger Overlay"
                       Foreground="#F4F7FA"
                       FontSize="34"
                       FontWeight="SemiBold" />
            <TextBlock Text="Warm-launch test surface for Pinball FX"
                       Foreground="#B6C2D0"
                       FontSize="16"
                       Margin="0,6,0,0" />
            <TextBlock x:Name="OverlayProcessStateText"
                       Foreground="#7FC8A9"
                       FontSize="14"
                       Margin="0,12,0,0"
                       Text="Checking Pinball FX process state..." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,24"
                BorderBrush="#303844"
                BorderThickness="1"
                Background="#181C22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Tables"
                           Foreground="#DDE5EE"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="18,16,18,12" />

                <ListBox x:Name="OverlayTableList"
                         Grid.Row="1"
                         Margin="16,0,16,16"
                         Background="#101318"
                         BorderBrush="#303844"
                         DisplayMemberPath="DisplayName"
                         Foreground="#F4F7FA" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button x:Name="OverlayRefreshStatusButton"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        Click="RefreshStatusButton_Click"
                        Content="Refresh Status" />
                <Button x:Name="HideOverlayButton"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        Click="HideOverlayButton_Click"
                        Content="Hide Overlay" />
                <Button x:Name="OverlayLaunchButton"
                        Width="180"
                        Height="40"
                        Click="LaunchButton_Click"
                        Content="Launch Selected Table" />
            </StackPanel>

            <TextBlock x:Name="OverlayStatusText"
                       VerticalAlignment="Center"
                       Foreground="#AAB3C0"
                       Text="Use Ctrl+Alt+Space to toggle the overlay." />
        </DockPanel>
    </Grid>
</Window>
